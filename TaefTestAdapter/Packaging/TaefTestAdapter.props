<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <IsTestProject>true</IsTestProject>
    <TaefTestAdapterPackageDirectory Condition="'$(TaefTestAdapterPackageDirectory)' == ''">$(MSBuildThisFileDirectory)..\build\_common\</TaefTestAdapterPackageDirectory>
    <TestAdapterPath>$(TestAdapterPath);$(TaefTestAdapterPackageDirectory)</TestAdapterPath>
  </PropertyGroup>
</Project>
