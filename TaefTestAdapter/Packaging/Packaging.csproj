<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Creates the VSIX (TaefTestAdapter.vsix) and the NuGet package (TaefTestAdapter.<version>.nupkg) of the Test Adapter for TAEF.
       The output folder of this project also contains everything needed to use the adapter with vstest.console.exe (/TestAdapterPath:). -->
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), Common.props))\Common.props" />
  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <!-- NuGet (PackageReference): see VsPackage.csproj -->
    <RestorePackagesPath>$(NuGetPackages)</RestorePackagesPath>
    <MSBuildProjectExtensionsPath>$(OutRoot)intermediate\$(SolutionName)\NuGet\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{4735D8CC-FA30-432D-854C-2984A7DA5DD2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Packaging</RootNamespace>
    <AssemblyName>Packaging</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <TargetVsixContainerName>TaefTestAdapter.vsix</TargetVsixContainerName>
    <!-- this project's own (empty) assembly is not part of the VSIX -->
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <!-- validate the VSIX (manifest schema, assets) when creating it -->
    <BypassVsixValidation>false</BypassVsixValidation>
    <!-- never deploy into the experimental instance of Visual Studio from command line builds -->
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' != 'true'">false</DeployExtension>
    <!-- set to false to skip the creation of the NuGet package -->
    <CreateNuGetPackage Condition="'$(CreateNuGetPackage)' == ''">true</CreateNuGetPackage>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="VsPackage.nuspec">
      <SubType>Designer</SubType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\ProjectTemplates\Test\TAEF\**\*">
      <Link>ProjectTemplates\Test\TAEF\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\ItemTemplates\Test\TAEF\**\*">
      <Link>ItemTemplates\Test\TAEF\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- included in the VSIX (as NOTICE.txt and ReleaseNotes.txt) by target IncludeLinkedFilesInVsix -->
    <Content Include="..\..\NOTICE">
      <Link>NOTICE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\CHANGELOG.md">
      <Link>ReleaseNotes.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- the readme of the NuGet package (see <readme> in VsPackage.nuspec); not included in the VSIX -->
    <Content Include="..\..\README.md">
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\taef-logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\taef-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Preview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NuGet.CommandLine" Version="6.14.3" GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The referenced projects' outputs (assemblies, x86\, x64\ and arm64\msdia140.dll of DiaResolver) are copied
         to the output folder and included in the VSIX; assemblies provided by Visual Studio are excluded from the VSIX by
         the VSSDK (SuppressFromVsix). -->
    <ProjectReference Include="..\Common\Common.csproj">
      <Project>{bc05d210-68cd-47d0-ae8c-0f3168d1be73}</Project>
      <Name>Common</Name>
    </ProjectReference>
    <ProjectReference Include="..\Core\Core.csproj">
      <Project>{7f4372da-70e2-48d0-bee2-8043528428d0}</Project>
      <Name>Core</Name>
    </ProjectReference>
    <ProjectReference Include="..\DiaResolver\DiaResolver.csproj">
      <Project>{fdc95d92-5e1e-4bdf-aa35-181851fce755}</Project>
      <Name>DiaResolver</Name>
    </ProjectReference>
    <ProjectReference Include="..\TestAdapter\TestAdapter.csproj">
      <Project>{44c04e51-d543-4155-a57e-bbeb73d3f8e5}</Project>
      <Name>TestAdapter</Name>
    </ProjectReference>
    <ProjectReference Include="..\VsPackage\VsPackage.csproj">
      <Project>{e6276cad-e4c3-4b25-876a-65b265ebff1a}</Project>
      <Name>VsPackage</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup%3bBuiltProjectOutputGroupDependencies%3bGetCopyToOutputDirectoryItems%3bSatelliteDllsProjectOutputGroup%3bPkgdefProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
      <IncludeOutputGroupsInVSIXLocalOnly>DebugSymbolsProjectOutputGroup%3b</IncludeOutputGroupsInVSIXLocalOnly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />

  <!-- Project and item templates: the template folders are zipped at build time and included in the VSIX
       (ProjectTemplates\Test\TaefTestPT.zip and ItemTemplates\Test\TaefTestIT.zip, see source.extension.vsixmanifest). -->
  <PropertyGroup>
    <TemplatesIntermediateDir>$(IntermediateOutputPath)Templates\</TemplatesIntermediateDir>
    <ProjectTemplateSourceDir>$(MSBuildProjectDirectory)\..\ProjectTemplates\Test\TAEF</ProjectTemplateSourceDir>
    <ProjectTemplateZip>$(TemplatesIntermediateDir)ProjectTemplates\Test\TaefTestPT.zip</ProjectTemplateZip>
    <ItemTemplateSourceDir>$(MSBuildProjectDirectory)\..\ItemTemplates\Test\TAEF</ItemTemplateSourceDir>
    <ItemTemplateZip>$(TemplatesIntermediateDir)ItemTemplates\Test\TaefTestIT.zip</ItemTemplateZip>
  </PropertyGroup>
  <ItemGroup>
    <_ProjectTemplateFile Include="$(ProjectTemplateSourceDir)\**\*" />
    <_ItemTemplateFile Include="$(ItemTemplateSourceDir)\**\*" />
  </ItemGroup>

  <Target Name="ZipProjectTemplate" Inputs="@(_ProjectTemplateFile)" Outputs="$(ProjectTemplateZip)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(ProjectTemplateZip)))" />
    <ZipDirectory SourceDirectory="$(ProjectTemplateSourceDir)" DestinationFile="$(ProjectTemplateZip)" Overwrite="true" />
  </Target>

  <Target Name="ZipItemTemplate" Inputs="@(_ItemTemplateFile)" Outputs="$(ItemTemplateZip)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(ItemTemplateZip)))" />
    <ZipDirectory SourceDirectory="$(ItemTemplateSourceDir)" DestinationFile="$(ItemTemplateZip)" Overwrite="true" />
  </Target>

  <Target Name="IncludeTemplatesInVsix" BeforeTargets="GetVsixSourceItems" DependsOnTargets="ZipProjectTemplate;ZipItemTemplate">
    <ItemGroup>
      <Content Include="$(ProjectTemplateZip)">
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>ProjectTemplates\Test</VSIXSubPath>
        <Visible>false</Visible>
      </Content>
      <Content Include="$(ItemTemplateZip)">
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>ItemTemplates\Test</VSIXSubPath>
        <Visible>false</Visible>
      </Content>
      <FileWrites Include="$(ProjectTemplateZip);$(ItemTemplateZip)" />
    </ItemGroup>
  </Target>

  <!-- the VSIX takes the file names of the Content items' source files, so the linked files (NOTICE as NOTICE.txt,
       CHANGELOG.md as ReleaseNotes.txt, see <ReleaseNotes> in source.extension.vsixmanifest) are taken from the output folder -->
  <Target Name="IncludeLinkedFilesInVsix" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <Content Include="$(OutDir)NOTICE.txt">
        <Link>NOTICE.txt</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
        <Visible>false</Visible>
      </Content>
      <Content Include="$(OutDir)ReleaseNotes.txt">
        <Link>ReleaseNotes.txt</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

  <!-- NuGet package: contains the adapter's runtime files (see VsPackage.nuspec), for use as development dependency of
       test projects (e.g. on build servers). Created from the output folder. -->
  <PropertyGroup>
    <NuGetExe>$(PkgNuGet_CommandLine)\tools\NuGet.exe</NuGetExe>
    <NuGetPackageMarkerFile>$(OutDir)_.txt</NuGetPackageMarkerFile>
    <!-- the nuspec that is packed: VsPackage.nuspec with the source commit, see target AddRepositoryCommitToNuspec -->
    <NuGetPackageNuspec>$(IntermediateOutputPath)VsPackage.nuspec</NuGetPackageNuspec>
    <!-- XSLT 1.0: copies the nuspec and sets the attribute commit of its <repository> element to the parameter commit
         (removes it if the parameter is empty) -->
    <RepositoryCommitXslt><![CDATA[<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:param name="commit" />
  <xsl:template match="@*|node()">
    <xsl:copy><xsl:apply-templates select="@*|node()" /></xsl:copy>
  </xsl:template>
  <xsl:template match="/*[local-name()='package']/*[local-name()='metadata']/*[local-name()='repository']">
    <xsl:copy>
      <xsl:apply-templates select="@*[local-name()!='commit']" />
      <xsl:if test="$commit != ''">
        <xsl:attribute name="commit"><xsl:value-of select="$commit" /></xsl:attribute>
      </xsl:if>
      <xsl:apply-templates select="node()" />
    </xsl:copy>
  </xsl:template>
</xsl:stylesheet>]]></RepositoryCommitXslt>
  </PropertyGroup>

  <!-- The commit the package is built from (<repository commit="..."> in the package): RepositoryCommit if given (for
       example, /p:RepositoryCommit=<commit> when building from a source archive), otherwise 'git rev-parse HEAD' in the
       enlistment if it is a git checkout (it has .git, a folder, or a file in worktrees and submodules; git is not run in
       other folders, where it would return the commit of an enclosing repository). If git is not available or the
       enlistment is not a git checkout, the package is created without it. -->
  <Target Name="GetRepositoryCommit">
    <PropertyGroup>
      <_CommitHashPattern>^[0-9a-f]{40}([0-9a-f]{24})?$</_CommitHashPattern>
    </PropertyGroup>
    <Error Condition="'$(RepositoryCommit)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryCommit)', '$(_CommitHashPattern)'))" Text="RepositoryCommit '$(RepositoryCommit)' is not a git commit hash (40 or 64 lowercase hexadecimal digits)." />
    <Exec Condition="'$(RepositoryCommit)' == '' And Exists('$(EnlistmentRoot).git')" Command="git rev-parse HEAD 2&gt;nul" WorkingDirectory="$(EnlistmentRoot)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRevParseOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevParseExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(RepositoryCommit)' == '' And '$(_GitRevParseExitCode)' == '0' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitRevParseOutput.Trim())', '$(_CommitHashPattern)'))">
      <_RepositoryCommitIsHead>true</_RepositoryCommitIsHead>
      <RepositoryCommit>$(_GitRevParseOutput.Trim())</RepositoryCommit>
    </PropertyGroup>
    <Message Condition="'$(RepositoryCommit)' == ''" Importance="high" Text="The NuGet package is created without the source commit: $(EnlistmentRoot) is not a git checkout, or 'git rev-parse HEAD' failed there (git is not available)." />
    <!-- the commit does not contain uncommitted changes: a message (not a warning, as in development builds these are
         common) reminds to build the package to be published after committing -->
    <Exec Condition="'$(_RepositoryCommitIsHead)' == 'true'" Command="git status --porcelain --untracked-files=no 2&gt;nul" WorkingDirectory="$(EnlistmentRoot)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatusOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitStatusExitCode" />
    </Exec>
    <Message Condition="'$(_RepositoryCommitIsHead)' == 'true' And '$(_GitStatusExitCode)' == '0' And '$(_GitStatusOutput)' != ''" Importance="high" Text="The NuGet package records the source commit $(RepositoryCommit), but $(EnlistmentRoot) has uncommitted changes, which that commit does not contain: build the package to be published after committing them." />
  </Target>

  <Target Name="AddRepositoryCommitToNuspec" DependsOnTargets="GetRepositoryCommit">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(NuGetPackageNuspec)))" />
    <XslTransformation XmlInputPaths="$(OutDir)VsPackage.nuspec" XslContent="$(RepositoryCommitXslt)" OutputPaths="$(NuGetPackageNuspec)" Parameters="&lt;Parameter Name=&quot;commit&quot; Value=&quot;$(RepositoryCommit)&quot; /&gt;" />
    <ItemGroup>
      <FileWrites Include="$(NuGetPackageNuspec)" />
    </ItemGroup>
  </Target>

  <Target Name="CreateNuGetPackage" AfterTargets="Build" DependsOnTargets="AddRepositoryCommitToNuspec" Condition="'$(CreateNuGetPackage)' == 'true'">
    <Error Condition="!Exists('$(NuGetExe)')" Text="NuGet.exe not found at '$(NuGetExe)' - restore the NuGet packages of the solution." />
    <!-- at least one file is needed within the lib\native folder to convince VS that the package can be installed into native C++ projects -->
    <WriteLinesToFile File="$(NuGetPackageMarkerFile)" Lines="This file makes the package installable into native C++ projects." Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- the nuspec takes the optional arm64\msdia140.dll with a wildcard, which fails if the folder does not exist -->
    <MakeDir Directories="$(OutDir)arm64" />
    <!-- the files of the package are taken from the output folder (BasePath) -->
    <Exec Command="&quot;$(NuGetExe)&quot; pack &quot;$(NuGetPackageNuspec)&quot; -BasePath &quot;$(OutDir.TrimEnd('\'))&quot; -OutputDirectory &quot;$(OutDir.TrimEnd('\'))&quot; -NonInteractive -NoPackageAnalysis -ForceEnglishOutput" />
    <ItemGroup>
      <FileWrites Include="$(NuGetPackageMarkerFile);$(OutDir)TaefTestAdapter.*.nupkg" />
    </ItemGroup>
  </Target>

  <Target Name="DeleteNuGetPackages" AfterTargets="Clean">
    <ItemGroup>
      <_NuGetPackageToDelete Include="$(OutDir)TaefTestAdapter.*.nupkg" />
    </ItemGroup>
    <Delete Files="@(_NuGetPackageToDelete);$(NuGetPackageMarkerFile);$(NuGetPackageNuspec)" />
  </Target>
</Project>
