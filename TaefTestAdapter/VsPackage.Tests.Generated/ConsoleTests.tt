<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ output extension=".cs" encoding="utf-8" #>
<#
    // This template has been modified for TAEF support. It is self-contained (it does not load any assembly of the
    // solution), and its output ConsoleTests.cs is checked in; regenerate it after changing TAEF_Console.csv:
    // - in Visual Studio: right-click ConsoleTests.tt, Run Custom Tool (or save the template), or
    // - with MSBuild: msbuild VsPackage.Tests.Generated.csproj /t:TransformAll (the build itself does not transform it), or
    // - with "%VSINSTALLDIR%Common7\IDE\TextTransform.exe" ConsoleTests.tt
    // ConsoleTestsGenerationTests checks that ConsoleTests.cs is up to date.
    List<ConsoleTestDefinition> testCases = ConsoleTestDefinition.ReadCsv(Host.ResolvePath("TAEF_Console.csv"));
#>
// <auto-generated>
// This file has been generated by ConsoleTests.tt from TAEF_Console.csv - do not edit it, but edit the CSV file and
// regenerate this file (see ConsoleTests.tt).
// </auto-generated>

using Microsoft.VisualStudio.TestTools.UnitTesting;
using TaefTestAdapter.Tests.Common;
using static TaefTestAdapter.Tests.Common.TestMetadata.TestCategories;

namespace TaefTestAdapter.VsPackage
{
    [TestClass]
    public partial class ConsoleDllTests : AbstractConsoleTests
    {
<#
    foreach (ConsoleTestDefinition testCase in testCases)
    {
#>

        [TestMethod<#= testCase.Ignore ? ", Ignore" : "" #>]
        [TestCategory(EndToEnd)]
        public void <#= testCase.MethodName #>()
        {
            RunConsoleTest(new ConsoleTestCase
            {
                TestFile = <#= Literal(testCase.TestFile) #>,
                Settings = <#= Literal(testCase.Settings) #>,
                TestCaseFilter = <#= Literal(testCase.TestCaseFilter) #>,
                EnableCodeCoverage = <#= Literal(testCase.EnableCodeCoverage) #>,
                InIsolation = <#= Literal(testCase.InIsolation) #>,
                RunInProcess = <#= Literal(testCase.RunInProcess) #>,
                RunIgnoredTests = <#= Literal(testCase.RunIgnoredTests) #>,
                IsolationLevel = <#= Literal(testCase.IsolationLevel) #>,
                NrOfTestRepetitions = <#= testCase.NrOfTestRepetitions #>
            });
        }
<#
    }

    foreach (string testFile in testCases.Select(tc => tc.TestFile).Distinct())
    {
#>

        [TestMethod]
        [TestCategory(EndToEnd)]
        public void List_TestsOf_<#= testFile #>()
        {
            ListFullyQualifiedTestsOf(<#= Literal(testFile) #>);
        }
<#
    }
#>

    }
}
<#+
    private static string Literal(string value)
    {
        return "@\"" + value.Replace("\"", "\"\"") + "\"";
    }

    private static string Literal(bool value)
    {
        return value ? "true" : "false";
    }

    /// <summary>
    /// A row of TAEF_Console.csv (tab separated, first row: column names; see TAEF_Console.pictmodel). Columns TestFile,
    /// Settings and TestCaseFilter are required; the others are optional (default: false, false, false, default, Default,
    /// 1 and false).
    /// </summary>
    private class ConsoleTestDefinition
    {
        /// <summary>
        /// Maximum length of the names of the generated tests. The names are also part of the names of the golden files
        /// (GoldenFiles\ConsoleDllTests__&lt;name&gt;.xml), and git for Windows can not check out paths of 260 or more
        /// characters (unless core.longpaths is enabled): with this maximum, the paths of the golden files relative to the
        /// enlistment root have at most 147 characters (checked by ConsoleTestsGenerationTests).
        /// </summary>
        private const int MaxMethodNameLength = 72;

        /// <summary>Length of the suffix "_&lt;hash&gt;" of shortened names.</summary>
        private const int HashSuffixLength = 9;

        public string TestFile;
        public string Settings;
        public string TestCaseFilter;
        public bool EnableCodeCoverage;
        public bool InIsolation;
        public bool RunInProcess;
        public string RunIgnoredTests = "default";
        public string IsolationLevel = "Default";
        public int NrOfTestRepetitions = 1;
        public bool Ignore;

        public static List<ConsoleTestDefinition> ReadCsv(string csvFile)
        {
            string[] lines = File.ReadAllLines(csvFile)
                .Where(l => !string.IsNullOrWhiteSpace(l))
                .ToArray();
            string[] columns = lines[0].Split('\t').Select(c => c.Trim()).ToArray();

            var testCases = new List<ConsoleTestDefinition>();
            foreach (string line in lines.Skip(1))
            {
                string[] values = line.Split('\t').Select(v => v.Trim()).ToArray();
                if (values.Length != columns.Length)
                    throw new Exception("Wrong number of values in line '" + line + "' of " + csvFile);
                var row = new Dictionary<string, string>();
                for (int i = 0; i < columns.Length; i++)
                    row[columns[i]] = values[i];

                testCases.Add(new ConsoleTestDefinition
                {
                    TestFile = row["TestFile"],
                    Settings = row["Settings"],
                    TestCaseFilter = row["TestCaseFilter"],
                    EnableCodeCoverage = GetBool(row, "EnableCodeCoverage"),
                    InIsolation = GetBool(row, "InIsolation"),
                    RunInProcess = GetBool(row, "RunInProcess"),
                    RunIgnoredTests = row.ContainsKey("RunIgnoredTests") ? row["RunIgnoredTests"] : "default",
                    IsolationLevel = row.ContainsKey("IsolationLevel") ? row["IsolationLevel"] : "Default",
                    NrOfTestRepetitions = row.ContainsKey("NrOfTestRepetitions") ? int.Parse(row["NrOfTestRepetitions"]) : 1,
                    Ignore = GetBool(row, "Ignore")
                });
            }

            var duplicates = testCases.GroupBy(tc => tc.MethodName).Where(g => g.Count() > 1).Select(g => g.Key).ToList();
            if (duplicates.Any())
                throw new Exception("Duplicate test cases in " + csvFile + ": " + string.Join(", ", duplicates));

            return testCases;
        }

        private static bool GetBool(IDictionary<string, string> row, string column)
        {
            return row.ContainsKey(column) && bool.Parse(row[column]);
        }

        /// <summary>
        /// The name of the test: the test file followed by abbreviations of the options which are not at their defaults
        /// (e.g. _SlnProjSettings, _Cov, _Iso, _InProc, _SkipIgn, _ClassLevel, _Rep2) and by the test case filter (e.g.
        /// _FQN_CONTAINS_NamedRows). Names longer than <see cref="MaxMethodNameLength"/> are shortened and made unique by
        /// a hash of the complete name (e.g. SampleTests_Settings_Iso_SkipIgn_MethodLevel_Rep2_TestCategory_&lt;hash&gt;).
        /// </summary>
        public string MethodName
        {
            get
            {
                string settings;
                switch (Settings)
                {
                    case "false": settings = ""; break;
                    case "true": settings = "_Settings"; break;
                    case "Solution": settings = "_SlnSettings"; break;
                    case "SolutionProject": settings = "_SlnProjSettings"; break;
                    default: settings = "_" + Settings + "Settings"; break;
                }

                string codeCoverage = EnableCodeCoverage ? "_Cov" : "";
                string isolation = InIsolation ? "_Iso" : "";
                string inProcess = RunInProcess ? "_InProc" : "";
                string ignoredTests = RunIgnoredTests == "true" ? "_RunIgn" : RunIgnoredTests == "false" ? "_SkipIgn" : "";
                string isolationLevel = IsolationLevel == "Default" ? "" : "_" + IsolationLevel + "Level";
                string repetitions = NrOfTestRepetitions == 1 ? "" : "_Rep" + NrOfTestRepetitions;
                string filter = TestCaseFilter == "none" ? "" : "_" + TestCaseFilter.Replace("FullyQualifiedName", "FQN");

                string result = TestFile + settings + codeCoverage + isolation + inProcess + ignoredTests + isolationLevel + repetitions + filter;

                result = result.Replace("::", "_");
                result = result.Replace(".", "_");
                result = result.Replace("!=", "_NEQ_");
                result = result.Replace("!~", "_NCONTAINS_");
                result = result.Replace("=", "_EQ_");
                result = result.Replace("~", "_CONTAINS_");
                result = result.Replace("|", "_OR_");
                result = result.Replace("&", "_AND_");

                bool isNegative = result.Contains("*");
                result = result.Replace("*", "");

                // TAEF names may contain characters which are not allowed in C# identifiers (e.g. '#', ' ', '<')
                var identifier = new StringBuilder(result.Length);
                foreach (char c in result)
                    identifier.Append(char.IsLetterOrDigit(c) || c == '_' ? c : '_');
                result = identifier.ToString();
                if (isNegative)
                    result = "NEG_" + result;

                return Shorten(result);
            }
        }

        /// <returns>
        /// <paramref name="name"/> if it is not longer than <see cref="MaxMethodNameLength"/>, otherwise its beginning
        /// followed by "_" and a (stable) hash of the complete name.
        /// </returns>
        private static string Shorten(string name)
        {
            if (name.Length <= MaxMethodNameLength)
                return name;

            // FNV-1a (string.GetHashCode() is not stable across processes and .NET versions)
            uint hash = 2166136261u;
            foreach (char c in name)
            {
                hash ^= c;
                hash = unchecked(hash * 16777619u);
            }

            // cut at the end of a "word" if possible
            string beginning = name.Substring(0, MaxMethodNameLength - HashSuffixLength + 1);
            int lastSeparator = beginning.LastIndexOf('_');
            beginning = lastSeparator > beginning.Length / 2 ? beginning.Substring(0, lastSeparator) : beginning.Substring(0, beginning.Length - 1);
            return beginning.TrimEnd('_') + "_" + hash.ToString("x8");
        }
    }
#>
