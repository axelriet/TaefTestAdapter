  <!--
    Debugging (F5): runs vstest.console.exe of the running Visual Studio with the adapter just built against a test of the
    x64 TAEF sample test DLL (build SampleTests.sln for x64 first). vstest.console.exe usually loads the adapter into its
    own process; if it uses a test host process instead (testhost*.exe), set environment variable VSTEST_HOST_DEBUG=1 or
    use the child process debugging settings (TaefTestAdapter.ChildProcessDbgSettings).
  -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)Extensions\TestPlatform\vstest.console.exe</StartProgram>
    <StartArguments>"$(OutRoot)binaries\SampleTests\$(Configuration)-x64\Tests_taef.dll" /Settings:"$(EnlistmentRoot)SampleTests\SampleTests.taef.runsettings" /TestCaseFilter:"DisplayName=TaefSamples::TestMath::AddPasses" /TestAdapterPath:"$(TargetDir)"</StartArguments>
    <StartWorkingDirectory>$(EnlistmentRoot)SampleTests\</StartWorkingDirectory>
  </PropertyGroup>
