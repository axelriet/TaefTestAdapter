  </ItemGroup>
  <ItemGroup>
    <!-- Visual Studio 2022 17.0 SDK: its assemblies are provided by Visual Studio at runtime. Visual Studio redirects each of
         them to the version it ships, but only from lower versions, so the package must not be compiled against assemblies
         newer than those of the oldest Visual Studio it can be installed into (InstallationTarget of
         Packaging\source.extension.vsixmanifest, currently 17.0; checked by the VsPackage.Tests.Unit test
         VsixManifestTests.VsPackageAssembly_ReferencesNoVisualStudioAssemblyNewerThanMinimumInstallationTarget).
         Threading and Validation, which the package uses directly, are referenced explicitly to keep them at 17.0. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.0.64" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Validation" Version="17.0.28" ExcludeAssets="runtime" />
    <!-- IWizard, implemented by the wizard of the project and item templates (Templates\TaefTemplateWizard.cs), is not part of
         the SDK package -->
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.0.31902.203" ExcludeAssets="runtime" />
    <!-- the build tools are independent of the SDK version (and of the Visual Studio versions the extension supports);
         17.14 is needed to build with the MSBuild of Visual Studio 2026 -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- IRunSettingsService (Test Explorer) and the test platform's object model; provided by Visual Studio at runtime. The
         object model is the one of Visual Studio 2022 17.0 (see TestAdapter.csproj); Visual Studio redirects all versions of
         it, including version 11.0.0.0 referenced by TestWindow.Interfaces, to the version it ships (15.0.0.0). -->
    <PackageReference Include="Microsoft.VisualStudio.TestWindow.Interfaces" Version="11.0.61030" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="17.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
