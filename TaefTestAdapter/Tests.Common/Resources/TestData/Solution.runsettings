<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback settings of the generated end-to-end tests (CSV key 'Solution'): solution settings only (the project settings are empty) -->
<RunSettings>
  <TaefTestAdapterSettings>
    <SolutionSettings>
      <Settings>
        <MaxNrOfThreads>3</MaxNrOfThreads>
        <WorkingDir>$(TestDllDir)\..</WorkingDir>
        <RunIgnoredTests>true</RunIgnoredTests>
      </Settings>
    </SolutionSettings>
    <ProjectSettings>
      <Settings ProjectRegex=".*\\Tests_taef\.dll">
      </Settings>
    </ProjectSettings>
  </TaefTestAdapterSettings>
</RunSettings>
