  <!--
    Build information used by TestResources to find the enlistment, the adapter's build output and the sample test DLLs
    independently of the current directory and of an isolated OutRoot (see TestResources.cs): the values are embedded as
    [assembly: AssemblyMetadata("TaefTestAdapter.Tests.<Key>", "<value>")] attributes.
  -->
  <PropertyGroup>
    <TestsCommonBuildInfoFile>$(IntermediateOutputPath)TestsCommonBuildInfo.g.cs</TestsCommonBuildInfoFile>
  </PropertyGroup>
  <Target Name="GenerateTestsCommonBuildInfo" BeforeTargets="CoreCompile" DependsOnTargets="PrepareForBuild">
    <ItemGroup>
      <_TestsCommonBuildInfo Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TaefTestAdapter.Tests.EnlistmentRoot</_Parameter1>
        <_Parameter2>$([System.IO.Path]::GetFullPath('$(EnlistmentRoot)'))</_Parameter2>
      </_TestsCommonBuildInfo>
      <_TestsCommonBuildInfo Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TaefTestAdapter.Tests.OutRoot</_Parameter1>
        <_Parameter2>$([System.IO.Path]::GetFullPath('$(OutRoot)'))</_Parameter2>
      </_TestsCommonBuildInfo>
      <_TestsCommonBuildInfo Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TaefTestAdapter.Tests.TestsCommonOutDir</_Parameter1>
        <_Parameter2>$([System.IO.Path]::GetFullPath('$(OutDir)'))</_Parameter2>
      </_TestsCommonBuildInfo>
      <_TestsCommonBuildInfo Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TaefTestAdapter.Tests.Configuration</_Parameter1>
        <_Parameter2>$(Configuration)</_Parameter2>
      </_TestsCommonBuildInfo>
      <_TestsCommonBuildInfo Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TaefTestAdapter.Tests.SolutionName</_Parameter1>
        <_Parameter2>$(SolutionName)</_Parameter2>
      </_TestsCommonBuildInfo>
    </ItemGroup>
    <!-- only replace the generated file if its content changes (avoids recompiling Tests.Common and its dependents) -->
    <WriteCodeFragment Language="C#" OutputFile="$(TestsCommonBuildInfoFile).tmp" AssemblyAttributes="@(_TestsCommonBuildInfo)" />
    <PropertyGroup>
      <_TestsCommonBuildInfoChanged>true</_TestsCommonBuildInfoChanged>
      <_TestsCommonBuildInfoChanged Condition="Exists('$(TestsCommonBuildInfoFile)') and '$([System.String]::Equals($([System.IO.File]::ReadAllText($(TestsCommonBuildInfoFile))), $([System.IO.File]::ReadAllText($(TestsCommonBuildInfoFile).tmp))))' == 'True'">false</_TestsCommonBuildInfoChanged>
    </PropertyGroup>
    <Copy Condition="'$(_TestsCommonBuildInfoChanged)' == 'true'" SourceFiles="$(TestsCommonBuildInfoFile).tmp" DestinationFiles="$(TestsCommonBuildInfoFile)" />
    <Delete Files="$(TestsCommonBuildInfoFile).tmp" />
    <ItemGroup>
      <Compile Include="$(TestsCommonBuildInfoFile)" />
      <FileWrites Include="$(TestsCommonBuildInfoFile)" />
    </ItemGroup>
  </Target>
