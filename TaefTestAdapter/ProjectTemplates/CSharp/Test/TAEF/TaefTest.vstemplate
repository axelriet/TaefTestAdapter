<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>TAEF C# Test Project</Name>
    <Description>A managed TAEF test project for .NET Framework or modern .NET. Requires the Windows Driver Kit TAEF runtime.</Description>
    <ProjectType>CSharp</ProjectType>
    <TemplateID>TaefTestAdapter.CSharp.Project.TaefTest</TemplateID>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>TaefTests</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>windows</PlatformTag>
    <ProjectTypeTag>test</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$projectname$.csproj" File="TaefTest.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="Tests.cs" OpenInEditor="true">test.cs</ProjectItem>
    </Project>
    <CustomParameters>
      <CustomParameter Name="$taeflanguage$" Value="CSharp" />
    </CustomParameters>
  </TemplateContent>
  <WizardExtension>
    <Assembly>TaefTestAdapter.VsPackage, Version=1.0.2.0, Culture=neutral, PublicKeyToken=6dd9e1a7dfb9193e</Assembly>
    <FullClassName>TaefTestAdapter.VsPackage.Templates.TaefTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
