<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Change this to net8.0 or net10.0 for modern .NET, or use TargetFrameworks to target both runtimes. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>$taefnamespace$</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <IsTestProject>true</IsTestProject>
    <DebugType>portable</DebugType>
    <TaefRuntimeDirectory Condition="'$(TaefRuntimeDirectory)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\Testing\Runtimes\TAEF\</TaefRuntimeDirectory>
    <TaefManagedFramework>netstandard2.0</TaefManagedFramework>
    <TaefManagedFramework Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net4'))">NetFx4.5</TaefManagedFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="TaefTestAdapter" Version="1.0.2" PrivateAssets="all" />
    <Reference Include="TE.Managed">
      <HintPath>$(TaefRuntimeDirectory)$(TaefManagedFramework)\TE.Managed.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Wex.Common.Managed">
      <HintPath>$(TaefRuntimeDirectory)$(TaefManagedFramework)\Wex.Common.Managed.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Wex.Logger.Interop">
      <HintPath>$(TaefRuntimeDirectory)$(TaefManagedFramework)\Wex.Logger.Interop.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckTaefRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TaefRuntimeDirectory)$(TaefManagedFramework)\TE.Managed.dll')" Text="TAEF managed libraries were not found. Install the Windows Driver Kit or set TaefRuntimeDirectory to its Testing\Runtimes\TAEF folder." />
  </Target>
</Project>
