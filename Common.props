<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <EnlistmentRoot>$(MSBuildThisFileDirectory)</EnlistmentRoot>
        <NuGetPackages>$(EnlistmentRoot)NuGetPackages\</NuGetPackages>

        <!-- Root of all build outputs; can be overridden (e.g. /p:OutRoot=C:\tmp\out\) to build in isolation. -->
        <OutRoot Condition="'$(OutRoot)' == ''">$(EnlistmentRoot)out\</OutRoot>

        <OutDir>$(OutRoot)binaries\$(SolutionName)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
        <OutputPath>$(OutDir)</OutputPath>

        <IntDir>$(OutRoot)intermediate\$(SolutionName)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
        <!-- C++ projects are built for several platforms: keep their intermediate files apart -->
        <IntDir Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">$(OutRoot)intermediate\$(SolutionName)\$(Configuration)\$(Platform)\$(MSBuildProjectName)\</IntDir>
        <IntermediateOutputPath>$(IntDir)</IntermediateOutputPath>
        <BaseIntermediateOutputPath>$(IntDir)</BaseIntermediateOutputPath>
    </PropertyGroup>
</Project>
